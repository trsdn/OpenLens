.build/
.DS_Store
# The generated project is committed on purpose. The notarization broker builds
# from a shallow checkout using only tooling preinstalled on the runner, and
# XcodeGen is not part of that image; fetching it would add an unpinned download
# to the job that handles source it does not trust. Regenerate with `xcodegen`
# after changing project.yml and commit the result.
OpenLens.xcodeproj/xcuserdata/
xcuserdata/
/*.xcworkspace

# Copied in by sync.sh so the plugin folder is self-contained; the original
# lives in Tools/openlens-mcp/src/client.js.
Tools/openlens-opendeck/com.trsdn.openlens.sdPlugin/vendor/
